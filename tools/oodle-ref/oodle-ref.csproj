<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>oodleref</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- OodleSharp is MIT (github.com/NotOfficer/OodleSharp). It is a local
         verification aid only — the shipped decoder is js/savparse.js. -->
    <PackageReference Include="OodleSharp" Version="0.0.1" />
  </ItemGroup>
</Project>
